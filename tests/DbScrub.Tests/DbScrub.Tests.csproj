<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tier only for now. The live-SQL integration tier (CLAUDE.md
       "Testing tiers") arrives in a later step behind the Enabled const
       and its source-scan guard test. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbScrub.Core\DbScrub.Core.csproj" />
    <ProjectReference Include="..\..\src\DbScrub.Cli\DbScrub.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SampleConfigLoads reads the real config/masking.sample.json, so a
         change that breaks validation fails the build instead of surfacing
         later at runtime. This entry exists ONLY to copy the file next to the
         test assembly.

         Visible="false" on purpose: config/ is a solution folder now, so the
         file is already browsable there. Without this the same file would
         appear twice in Solution Explorer, which is the confusion this
         restructure removed.

         create-test-db.sql and dbscrubtest.masking.json used to be linked here
         too. They are not, anymore — nothing in code reads them, so they live
         in the scripts/ and config/ solution folders where a human looks for
         them. When the Testcontainers tier lands and a test genuinely needs
         the DDL, it comes back as an EmbeddedResource. -->
    <None Include="..\..\config\masking.sample.json"
          Link="config\masking.sample.json"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
