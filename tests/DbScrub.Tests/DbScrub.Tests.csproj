<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tier only for now. The live-SQL integration tier (CLAUDE.md
       "Testing tiers") arrives in a later slice behind the Enabled const
       and its source-scan guard test. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbScrub.Core\DbScrub.Core.csproj" />
    <ProjectReference Include="..\..\src\DbScrub.Cli\DbScrub.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests load the real sample config, so a change to it that breaks
         validation fails the build instead of being discovered at runtime.
         Link keeps it at a predictable relative path in the output folder. -->
    <None Include="..\..\config\masking.sample.json"
          Link="config\masking.sample.json"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The DbScrubTest fixture. Linked, not moved: the file stays at
         scripts/create-test-db.sql so the sqlcmd path a human types stays
         short, and so it sits beside the other run-by-hand script. It belongs
         to THIS project because it is a test fixture — when the Testcontainers
         integration tier lands (DECISIONS.md roadmap v0.x) the test will
         execute this exact DDL, at which point this becomes an
         EmbeddedResource. No CopyToOutputDirectory yet: nothing reads it in
         code, and copying a file no test opens is just clutter in bin. -->
    <None Include="..\..\scripts\create-test-db.sql"
          Link="Fixtures\create-test-db.sql" />
    <None Include="..\..\config\dbscrubtest.masking.json"
          Link="Fixtures\dbscrubtest.masking.json" />
  </ItemGroup>

</Project>
