<Project>

  <!--
    Shared MSBuild settings for every project in this repo.
    MSBuild imports this automatically for any .csproj at or below this folder,
    so the individual .csproj files stay almost empty. One place to change the
    target framework or turn a warning into an error.
  -->
  <PropertyGroup>
    <!-- SPEC section 1: net10.0, per DECISIONS.md D30. .NET 8 leaves support in
         November 2026; 10 is the current long-term release and runs to 2028.
         The machine has the 10 SDK and runtime, and no 8 SDK at all. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- CLAUDE.md conventions -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- A nullable-reference warning in a tool that decides what to overwrite in
         a database is a bug report, not a suggestion. Fail the build on it. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Deterministic assembly version so the stamp's "tool version"
         (SPEC 5.5) is reproducible from a given commit. -->
    <Version>0.1.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
